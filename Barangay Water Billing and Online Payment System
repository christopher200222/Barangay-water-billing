<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Barangay Water Billing and Online Payment System</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-slate-100 font-sans antialiased text-slate-800">

  <!-- Top Navigation Bar -->
  <header class="bg-[#0b2b73] text-white flex justify-between items-center px-6 py-3.5 shadow-md">
    <div class="flex items-center space-x-3">
      <div class="bg-blue-500/20 p-2 rounded-full border border-blue-400/40">
        <i data-lucide="droplet" class="w-6 h-6 text-blue-300"></i>
      </div>
      <div>
        <h1 class="font-bold text-lg leading-tight">Barangay Water Billing System</h1>
        <p class="text-xs text-blue-200">Online Payment System</p>
      </div>
    </div>
    
    <div class="flex items-center space-x-6">
      <button class="relative hover:opacity-80 transition">
        <i data-lucide="bell" class="w-5 h-5"></i>
        <span class="absolute -top-1 -right-1 bg-red-500 text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center font-bold">3</span>
      </button>
      <div class="flex items-center space-x-2 cursor-pointer">
        <div class="bg-slate-200 p-1 rounded-full text-slate-700">
          <i data-lucide="user" class="w-5 h-5"></i>
        </div>
        <div class="text-left hidden sm:block">
          <p class="text-sm font-semibold leading-tight">Juan Dela Cruz</p>
          <p class="text-[11px] text-blue-200">Resident</p>
        </div>
      </div>
    </div>
  </header>

  <div class="flex min-h-[calc(100vh-65px)]">
    <!-- Sidebar -->
    <aside class="w-64 bg-[#0d348a] text-blue-100 flex flex-col justify-between py-4 px-3">
      <nav class="space-y-1">
        <a href="#" class="flex items-center gap-3 px-4 py-2.5 bg-blue-600 text-white rounded-xl font-medium shadow-sm">
          <i data-lucide="layout-dashboard" class="w-5 h-5"></i> Dashboard
        </a>
        <a href="#" class="flex items-center gap-3 px-4 py-2.5 hover:bg-blue-700/50 rounded-xl transition font-medium">
          <i data-lucide="file-text" class="w-5 h-5"></i> My Bills
        </a>
        <a href="#" class="flex items-center gap-3 px-4 py-2.5 hover:bg-blue-700/50 rounded-xl transition font-medium">
          <i data-lucide="bar-chart-2" class="w-5 h-5"></i> Consumption
        </a>
        <a href="#" class="flex items-center gap-3 px-4 py-2.5 hover:bg-blue-700/50 rounded-xl transition font-medium">
          <i data-lucide="credit-card" class="w-5 h-5"></i> Payments
        </a>
        <a href="#" class="flex items-center gap-3 px-4 py-2.5 hover:bg-blue-700/50 rounded-xl transition font-medium">
          <i data-lucide="calendar" class="w-5 h-5"></i> Billing History
        </a>
        <a href="#" class="flex items-center gap-3 px-4 py-2.5 hover:bg-blue-700/50 rounded-xl transition font-medium">
          <i data-lucide="user" class="w-5 h-5"></i> Profile
        </a>
        <a href="#" class="flex items-center gap-3 px-4 py-2.5 hover:bg-blue-700/50 rounded-xl transition font-medium">
          <i data-lucide="settings" class="w-5 h-5"></i> Settings
        </a>
      </nav>

      <div>
        <button class="flex items-center gap-3 px-4 py-2.5 text-blue-200 hover:text-white w-full hover:bg-red-500/20 rounded-xl transition font-medium">
          <i data-lucide="log-out" class="w-5 h-5"></i> Logout
        </button>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-6 lg:p-8 overflow-y-auto">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-slate-900">Welcome, Juan Dela Cruz!</h2>
        <p class="text-slate-500 text-sm">Account No: 2024-10023</p>
      </div>

      <!-- Top Metric Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <!-- Balance Card -->
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100 flex flex-col justify-between">
          <div class="flex items-start gap-4">
            <div class="p-3 bg-blue-50 text-blue-600 rounded-xl">
              <i data-lucide="wallet" class="w-6 h-6"></i>
            </div>
            <div>
              <span class="text-xs text-slate-500 font-medium">Current Balance</span>
              <p class="text-2xl font-bold text-slate-900 mt-1">₱ 320.00</p>
              <p class="text-xs text-slate-400 mt-0.5">Due on May 31, 2025</p>
            </div>
          </div>
          <button onclick="document.getElementById('paymentModal').classList.remove('hidden')" class="mt-4 w-full py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg shadow transition">
            Pay Now
          </button>
        </div>

        <!-- Monthly Consumption -->
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100 flex items-start gap-4">
          <div class="p-3 bg-cyan-50 text-cyan-600 rounded-xl">
            <i data-lucide="droplets" class="w-6 h-6"></i>
          </div>
          <div>
            <span class="text-xs text-slate-500 font-medium">Consumption</span>
            <p class="text-2xl font-bold text-slate-900 mt-1">12 m³</p>
            <p class="text-xs text-slate-400 mt-0.5">This Month</p>
          </div>
        </div>

        <!-- Billing Status -->
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100 flex items-start gap-4">
          <div class="p-3 bg-red-50 text-red-500 rounded-xl">
            <i data-lucide="alert-circle" class="w-6 h-6"></i>
          </div>
          <div>
            <span class="text-xs text-slate-500 font-medium">Status</span>
            <p class="text-2xl font-bold text-red-600 mt-1">Unpaid</p>
          </div>
        </div>

        <!-- Account Info -->
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100 flex items-start gap-4">
          <div class="p-3 bg-emerald-50 text-emerald-600 rounded-xl">
            <i data-lucide="user-check" class="w-6 h-6"></i>
          </div>
          <div>
            <span class="text-xs text-slate-500 font-medium">Account No.</span>
            <p class="text-lg font-bold text-slate-900 mt-1">2024-10023</p>
            <span class="inline-block bg-emerald-100 text-emerald-700 text-[10px] font-semibold px-2 py-0.5 rounded-full mt-1">Active</span>
          </div>
        </div>
      </div>

      <!-- Chart & Latest Bill Section -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
        <!-- Consumption Chart -->
        <div class="lg:col-span-2 bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
          <div class="flex justify-between items-center mb-4">
            <h3 class="font-bold text-slate-800">Consumption Overview (m³)</h3>
            <select class="text-xs border rounded-lg px-2 py-1 bg-slate-50 text-slate-600 outline-none">
              <option>This Year</option>
              <option>Last Year</option>
            </select>
          </div>
          <div class="h-64">
            <canvas id="consumptionChart"></canvas>
          </div>
        </div>

        <!-- Latest Bill Details -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-start mb-4">
              <h3 class="font-bold text-slate-800">Latest Bill</h3>
              <i data-lucide="receipt" class="w-8 h-8 text-slate-300"></i>
            </div>
            <p class="text-xs text-slate-500">Bill for May 2025</p>
            <div class="mt-4">
              <span class="text-xs text-slate-400">Amount</span>
              <p class="text-2xl font-bold text-slate-900">₱ 320.00</p>
            </div>
            <div class="mt-2">
              <span class="text-xs text-slate-400">Due Date</span>
              <p class="text-sm font-semibold text-slate-700">May 31, 2025</p>
            </div>
          </div>
          <button class="mt-6 w-full py-2 bg-slate-100 hover:bg-slate-200 text-blue-600 text-xs font-semibold rounded-lg flex items-center justify-center gap-1 transition">
            View Bill Details <i data-lucide="chevron-right" class="w-4 h-4"></i>
          </button>
        </div>
      </div>

      <!-- Summary Badges Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white p-4 rounded-xl border border-slate-100 flex items-center gap-3">
          <i data-lucide="badge-check" class="text-emerald-500 w-5 h-5"></i>
          <div>
            <p class="text-[11px] text-slate-400">Total Payments</p>
            <p class="font-bold text-slate-800 text-sm">₱ 1,950.00</p>
          </div>
        </div>
        <div class="bg-white p-4 rounded-xl border border-slate-100 flex items-center gap-3">
          <i data-lucide="history" class="text-purple-500 w-5 h-5"></i>
          <div>
            <p class="text-[11px] text-slate-400">Payment History</p>
            <p class="font-bold text-slate-800 text-sm">6 Transactions</p>
          </div>
        </div>
        <div class="bg-white p-4 rounded-xl border border-slate-100 flex items-center gap-3">
          <i data-lucide="file-check" class="text-amber-500 w-5 h-5"></i>
          <div>
            <p class="text-[11px] text-slate-400">Total Bills</p>
            <p class="font-bold text-slate-800 text-sm">6 This Year</p>
          </div>
        </div>
        <div class="bg-white p-4 rounded-xl border border-slate-100 flex items-center gap-3">
          <i data-lucide="activity" class="text-blue-500 w-5 h-5"></i>
          <div>
            <p class="text-[11px] text-slate-400">Total Consumption</p>
            <p class="font-bold text-slate-800 text-sm">78 m³</p>
          </div>
        </div>
      </div>

      <!-- Banner Footer Notification -->
      <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 flex items-center gap-3 text-blue-800 text-xs">
        <i data-lucide="info" class="w-5 h-5 text-blue-500 shrink-0"></i>
        <span>Thank you for using the Barangay Water Billing Online Payment System. Pay on time and help us serve you better!</span>
      </div>
    </main>
  </div>

  <!-- GCash / Payment Modal Prototype -->
  <div id="paymentModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 text-center">
      <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-3">
        <i data-lucide="smartphone" class="w-6 h-6"></i>
      </div>
      <h3 class="font-bold text-lg text-slate-900">Online GCash Payment</h3>
      <p class="text-xs text-slate-500 mt-1">Total Bill: <strong class="text-slate-900">₱ 320.00</strong></p>
      
      <div class="my-4 p-3 bg-slate-50 rounded-xl border text-xs text-left space-y-1">
        <p><strong>Merchant:</strong> Barangay Water Utility</p>
        <p><strong>Ref Code:</strong> BW-2024-10023</p>
        <p><strong>SMS Receipt:</strong> Sent to +63 912 *** 7890</p>
      </div>

      <div class="space-y-2">
        <button onclick="alert('Payment Successful via GCash Gateway!'); document.getElementById('paymentModal').classList.add('hidden')" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl text-sm transition">
          Confirm GCash Payment
        </button>
        <button onclick="document.getElementById('paymentModal').classList.add('hidden')" class="w-full py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 font-medium rounded-xl text-xs transition">
          Cancel
        </button>
      </div>
    </div>
  </div>

  <!-- Chart & Icon Initialization -->
  <script>
    lucide.createIcons();

    // Bar Chart Implementation
    const ctx = document.getElementById('consumptionChart').getContext('2d');
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
        datasets: [{
          data: [10, 8, 12, 7, 16, 18],
          backgroundColor: '#2563eb',
          borderRadius: 4,
          barThickness: 24
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, max: 20, grid: { color: '#f1f5f9' } },
          x: { grid: { display: false } }
        }
      }
    });
  </script>
</body>
</html>
